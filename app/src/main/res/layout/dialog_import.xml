<?xml version="1.0" encoding="utf-8"?>
<!-- 频道导入弹窗：左侧二维码+输入+按钮，右侧已保存源列表，左右对半 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_bg"
    android:orientation="horizontal">

    <!-- 左侧：二维码 + 输入 + 按钮（与右侧对半） -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- 标题 + 关闭按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/importTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/import_title"
                android:textColor="@color/accent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/importClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button"
                android:text="@string/import_close"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 可滚动区域：二维码 + 输入 + 按钮 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- 二维码卡片：二维码在上，提示文字在下方 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_qr_card"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/importQr"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:background="#FFFFFFFF"
                    android:contentDescription="@string/import_qr_desc"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/import_qr_hint"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/importUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="monospace"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="@string/import_qr_desc"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 网络地址输入 -->
            <EditText
                android:id="@+id/importInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="@string/import_input_hint"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="13sp" />

            <!-- 操作按钮行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/importCheck"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:text="@string/import_check"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/importFetch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:text="@string/import_fetch"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/importSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_button"
                android:text="@string/import_save"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 测试结果 -->
            <TextView
                android:id="@+id/importResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="16dp"
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <!-- 一键清理无效源 -->
            <Button
                android:id="@+id/importClean"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_button"
                android:text="@string/import_clean"
                android:textColor="@color/accent"
                android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:background="@color/panel_border" />

    <!-- 右侧：已保存源列表 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/import_saved_title"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/importSourceList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:divider="@color/item_divider"
            android:dividerHeight="1dp"
            android:listSelector="@android:color/transparent"
            android:overScrollMode="never"
            android:scrollbars="none" />
    </LinearLayout>
</LinearLayout>
