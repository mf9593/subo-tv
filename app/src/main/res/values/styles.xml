<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 电视端全屏无标题栏主题（API 14+，兼容 4.4） -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- 顶部栏标题 -->
    <style name="TopBarTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- 时钟 -->
    <style name="ClockText">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- OSD 频道号 -->
    <style name="OsdNumber">
        <item name="android:textColor">@color/channel_num_fg</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- OSD 频道名 -->
    <style name="OsdName">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- OSD 分组标签 -->
    <style name="OsdGroup">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- OSD 地址 -->
    <style name="OsdUrl">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">middle</item>
    </style>

    <!-- 状态文字 -->
    <style name="StateText">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>

    <!-- 频道列表分组头 -->
    <style name="GroupHeaderText">
        <item name="android:textColor">@color/group_header_fg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- 频道列表频道号 -->
    <style name="ChannelNumText">
        <item name="android:textColor">@color/channel_num_fg</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- 频道列表频道名 -->
    <style name="ChannelNameText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 频道列表频道名（未选中淡） -->
    <style name="ChannelNameTextDim" parent="ChannelNameText">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 底部提示 -->
    <style name="ToastText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 按键说明 -->
    <style name="KeyHint">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:alpha">0.4</item>
    </style>
</resources>
